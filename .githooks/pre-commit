#!/bin/sh
# Refuse a commit that stages a secret. Installed by `npm install` (core.hooksPath).
if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks protect --staged --redact
fi
echo "pre-commit: gitleaks not installed (brew install gitleaks); there is no CI, so run gitleaks by hand before sharing." >&2
